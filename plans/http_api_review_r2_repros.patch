diff --git a/src/emit/pipeline/tail.rs b/src/emit/pipeline/tail.rs
index 58a66a4..ae7fe02 100644
--- a/src/emit/pipeline/tail.rs
+++ b/src/emit/pipeline/tail.rs
@@ -939,6 +939,59 @@ where
 mod tests {
     use super::*;
 
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    #[ignore = "HOLD: cancellation during finish/quiesce releases live stages"]
+    async fn cancelled_tail_completion_must_keep_its_stages_counted() {
+        let mut joined_while_blocked = Vec::new();
+        for finish in [true, false] {
+            let set = crate::ops::writers::WriterSet::new();
+            let fatal = Fatal::new();
+            let (_, ack, mut parts) = spawn_null(Arc::new(Monotone::default()), fatal.clone());
+            let (msg_tx, msg_rx) = mpsc::channel(16);
+            let (release, held) = std::sync::mpsc::channel::<()>();
+            let (started_tx, started) = oneshot::channel();
+            parts.batcher = AbortOnDropHandle::new(tokio::spawn(async move {
+                let _rx = msg_rx;
+                let _ = started_tx.send(());
+                let _ = held.recv();
+            }));
+            started.await.unwrap();
+            let tail = OwnedTail {
+                msg_tx,
+                ack,
+                parts: Some(parts),
+                fatal,
+                context: "review",
+                writer: None,
+            }
+            .counted(Some(set.token()));
+            let (poll_tx, polled) = oneshot::channel();
+            let completion = tokio::spawn(async move {
+                let mut completion = Box::pin(async move {
+                    if finish {
+                        let _ = tail.finish(0).await;
+                    } else {
+                        tail.quiesce().await;
+                    }
+                });
+                assert!(futures::poll!(&mut completion).is_pending());
+                let _ = poll_tx.send(());
+                completion.await;
+            });
+            polled.await.unwrap();
+            completion.abort();
+            assert!(completion.await.unwrap_err().is_cancelled());
+            let joined = set.abort_and_join(Duration::from_millis(100)).await;
+            release.send(()).unwrap();
+            joined_while_blocked.push((finish, joined));
+            assert!(set.abort_and_join(Duration::from_secs(5)).await);
+        }
+        assert!(
+            joined_while_blocked.iter().all(|(_, joined)| !joined),
+            "completion cancelled with a blocked stage, but its writer set reported joined: {joined_while_blocked:?}"
+        );
+    }
+
