+    fn boot_must_refuse_its_own_unjoined_shutdown_claim() {
+        let root = config();
+        let tenants = TenantsConfig::from_table(&root).unwrap().unwrap();
+        let decl = tenants.get("a").unwrap();
+        let reservations = Reservations::default();
+        let spill = Path::new("/spill");
+        // Session shutdown retains this claim on an error, without marking it tearing down.
+        claim_resumed(&reservations, decl, &root, spill).unwrap();
+        assert!(
+            claim_resumed(&reservations, decl, &root, spill).is_err(),
+            "boot must not open a second runtime beside its own unjoined writer"
+        );
+    }
