# Builds the walshadow-ec2-bench binary and packages it in a small alpine
# runtime, so the latency bench can run from INSIDE the VPC (low RTT to the
# source Postgres / ClickHouse / standby) instead of from a workstation where
# the WAN round trip caps insert throughput.
#
# Snowflake uses walshadow's authenticated SQL client; build its native
# dependencies alongside the benchmark engine.
FROM rust:1-alpine AS builder
RUN apk add --no-cache build-base clang-dev cmake linux-headers lz4-dev zstd-dev
ENV RUSTFLAGS="-C target-feature=-crt-static"
ENV CFLAGS="-Dunreachable()=__builtin_unreachable()"
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY bench/Cargo.toml ./bench/Cargo.toml
COPY bench/src ./bench/src
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,id=walshadow-bench-target,target=/src/target \
    --mount=type=bind,source=.,target=/context \
    if [ -d /context/benches ]; then cp -r /context/benches ./benches; fi \
    && cargo build --release -p walshadow-bench --bin walshadow-ec2-bench \
    && cp /src/target/release/walshadow-ec2-bench /usr/local/bin/walshadow-ec2-bench

FROM alpine:3.24 AS runtime
RUN apk add --no-cache ca-certificates libgcc libstdc++ lz4-libs zstd-libs openssh-client
COPY --from=builder /usr/local/bin/walshadow-ec2-bench /usr/local/bin/walshadow-ec2-bench
ENTRYPOINT ["walshadow-ec2-bench"]
